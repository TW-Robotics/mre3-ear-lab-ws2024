<launch>
  <node pkg="pointcloud_to_laserscan" type="pointcloud_to_laserscan_node" name="pcl_to_scan">
    <remap from="cloud_in" to="/velodyne_points" />
    <remap from="scan" to="/alexBestScan" />
    <param name="target_frame" value="base_link"/>
    <param name="transform_tolerance" value="0.01" />
    <param name="min_height" value="0.1" />
    <param name="max_height" value="1.5" />
    <param name="angle_min" value="-1.57" />
    <param name="angle_max" value="1.57" />
    <param name="angle_increment" value="0.0043633" />
    <param name="scan_time" value="0.1" />
    <param name="range_min" value="0.45" />
    <param name="range_max" value="10.0" />
  </node>
</launch>